{
  "services": {
    "select_next_clip": {
      "service": "mdi:movie-open"
    },
    "reset_history": {
      "service": "mdi:history"
    },
    "refresh": {
      "service": "mdi:refresh"
    },
    "import_legacy": {
      "service": "mdi:import"
    }
  },
  "entity": {
    "sensor": {
      "active_season": {
        "default": "mdi:calendar"
      },
      "catalog": {
        "default": "mdi:filmstrip"
      }
    },
    "select": {
      "season_override": {
        "default": "mdi:calendar-edit"
      }
    },
    "binary_sensor": {
      "studio_connected": {
        "default": "mdi:lan-connect"
      }
    }
  }
}
